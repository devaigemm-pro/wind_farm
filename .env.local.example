# ─────────────────────────────────────────────────────────────────────────────
# Environment config — three environments (local / staging / prod)
# ─────────────────────────────────────────────────────────────────────────────
# This is a TEMPLATE (committed). Copy the relevant block into the real,
# git-ignored file for each environment. Never commit real keys.
#
# Vite loads (dev):   .env  →  .env.local  →  .env.[mode]  →  .env.[mode].local
# So the convention for this project is:
#
#   .env.local              → LOCAL development (Supabase running in Docker)
#   .env.production.local   → values that point to PRODUCTION (for a local
#                             build against prod; not used by `vite dev`)
#   Production deploy        → env vars are set in the Vercel project settings,
#                             NOT in a committed file.
#
# ── LOCAL (Supabase CLI / Docker) ────────────────────────────────────────────
# After `supabase start`, the CLI prints these fixed local values. They are the
# same for every Supabase local instance and are NOT secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key-printed-by-supabase-start>

# ── PRODUCTION (reference — real values live in Vercel + .env.production.local)
# VITE_SUPABASE_URL=https://<prod-project-id>.supabase.co
# VITE_SUPABASE_ANON_KEY=<prod-anon-key>

# ── STAGING (Phase 3 — a Supabase branch / second project) ───────────────────
# VITE_SUPABASE_URL=https://<staging-project-id>.supabase.co
# VITE_SUPABASE_ANON_KEY=<staging-anon-key>

# ── Server-only keys (never exposed to the browser; used by scripts/CLI) ─────
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_ACCESS_TOKEN=<cli-access-token>

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_FF_NEW_LAYOUT=true
