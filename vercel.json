{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "session/**": false
    }
  },
  "ignoreCommand": "if [[ \"$VERCEL_GIT_COMMIT_REF\" == session/* ]]; then exit 0; fi; exit 1"
}
